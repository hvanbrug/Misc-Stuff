<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HenksHotkeys</RootNamespace>
    <AssemblyName>HenksHotkeys</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Images\HenksHotkeys.ico</ApplicationIcon>
    <Version>2.3.0</Version>
    <Product>Henk's Hotkeys</Product>
    <AssemblyTitle>Henk's Hotkeys</AssemblyTitle>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Twemoji PNGs and the tray icon are embedded into the assembly manifest, so
       there are no loose files at runtime and everything bundles into the
       single-file exe. Loaded via Assembly.GetManifestResourceStream using the
       LogicalName below. The Remove lines stop the SDK default globs from also
       picking these up as None/Content/Resource (which would be a duplicate-item
       error now that they live inside the project). -->
  <ItemGroup>
    <None Remove="Images\**" />
    <Content Remove="Images\**" />
    <Resource Remove="Images\**" />
    <EmbeddedResource Include="Images\Twemoji\*.png">
      <LogicalName>twemoji.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Images\HenksHotkeys.ico">
      <LogicalName>app.ico</LogicalName>
    </EmbeddedResource>
    <!-- Default tab/button content, written to %LocalAppData% on first run. -->
    <EmbeddedResource Include="Resources\tabs.default.json">
      <LogicalName>tabs.default.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
