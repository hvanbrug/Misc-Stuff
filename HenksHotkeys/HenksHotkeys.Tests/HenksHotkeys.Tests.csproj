<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The app references WPF types (e.g. ImageSource in EmojiImageProvider), so
         the test assembly needs the WPF framework reference to load it. -->
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <RootNamespace>HenksHotkeys.Tests</RootNamespace>
    <AssemblyName>HenksHotkeys.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HenksHotkeys\HenksHotkeys.csproj" />
  </ItemGroup>

</Project>
