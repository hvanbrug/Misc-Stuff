<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is kept only for the few OS bits without a first-class WPF API:
         the tray icon (NotifyIcon), Clipboard and Screen. The UI itself is WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HenksHotkeys</RootNamespace>
    <AssemblyName>HenksHotkeys</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Images\HenksHotkeys.ico</ApplicationIcon>
    <Version>2.3.0</Version>
    <Product>Henk's Hotkeys</Product>
    <AssemblyTitle>Henk's Hotkeys</AssemblyTitle>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

    <!-- Drop the WinForms/Drawing implicit usings so WPF's System.Windows types
       (Application, MessageBox, Color, Point, Size…) are unambiguous. The handful
       of files that still need WinForms import it explicitly. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Twemoji PNGs and the tray icon are embedded into the assembly manifest
       (EmbeddedResource works for files outside the project cone, unlike WPF
       Resource), so there are no loose files at runtime and everything bundles
       into a future single-file exe. Loaded via Assembly.GetManifestResourceStream
       using the LogicalName below. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Images\Twemoji\*.png">
      <LogicalName>twemoji.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Images\HenksHotkeys.ico">
      <LogicalName>app.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
