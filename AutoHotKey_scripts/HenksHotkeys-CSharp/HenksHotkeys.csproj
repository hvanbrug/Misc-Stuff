<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is kept only for the few OS bits without a first-class WPF API:
         the tray icon (NotifyIcon), Clipboard and Screen. The UI itself is WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HenksHotkeys</RootNamespace>
    <AssemblyName>HenksHotkeys</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Images\HenksHotkeys.ico</ApplicationIcon>
    <Version>2.3.0</Version>
    <Product>Henk's Hotkeys</Product>
    <AssemblyTitle>Henk's Hotkeys</AssemblyTitle>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

    <!-- Drop the WinForms/Drawing implicit usings so WPF's System.Windows types
       (Application, MessageBox, Color, Point, Size…) are unambiguous. The handful
       of files that still need WinForms import it explicitly. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Twemoji PNGs are loaded from disk at runtime; copy them next to the exe. -->
  <ItemGroup>
    <None Include="..\Images\Twemoji\*.png" Link="Images\Twemoji\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Images\HenksHotkeys.ico" Link="Images\HenksHotkeys.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
