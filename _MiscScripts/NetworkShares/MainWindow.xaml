<Window x:Class="NetworkShares.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NetworkShares"
        Title="Network Shares" Height="780" Width="740"
        MinHeight="520" MinWidth="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}">

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="170"/>
    </Grid.RowDefinitions>

    <!-- All bar -->
    <Border Grid.Row="0" Background="{DynamicResource AccentBarBg}" BorderBrush="{DynamicResource AccentBarBorder}" BorderThickness="1"
            CornerRadius="6" Padding="12" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="All Mappings" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
          <TextBlock Text="Connect or disconnect every group at once." Foreground="{DynamicResource AccentText}" FontSize="11"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Connect All"    Command="{Binding ConnectAllCommand}"/>
          <Button Content="Disconnect All" Command="{Binding DisconnectAllCommand}" Margin="6,0,0,0"/>
          <Button Content="Refresh"        Command="{Binding RefreshCommand}"       Margin="6,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Groups -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                    CornerRadius="6" Padding="12" Margin="0,0,0,10">
              <StackPanel>
                <!-- header -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill}" Background="{Binding OverallBrush}" Margin="0,0,8,0">
                      <TextBlock Style="{StaticResource PillText}" Text="{Binding OverallText}"/>
                    </Border>
                    <PasswordBox Width="120" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource ControlBorder}"
                                 Visibility="{Binding IsConnectable, Converter={StaticResource BoolToVis}}"
                                 ToolTip="Password (optional — leave blank to use your saved / current credentials)"
                                 local:PasswordHelper.Attach="True"
                                 local:PasswordHelper.BoundPassword="{Binding Password, Mode=TwoWay}"/>
                    <Button Style="{StaticResource MiniButton}" Content="Connect"    Command="{Binding ConnectCommand}"
                            Visibility="{Binding IsConnectable, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource MiniButton}" Content="Reconnect"  Command="{Binding ReconnectCommand}"  Margin="4,0,0,0"/>
                    <Button Style="{StaticResource MiniButton}" Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="4,0,0,0"/>
                    <Button Style="{StaticResource MiniButton}" Content="Unmap"      Command="{Binding UnmapCommand}"      Margin="4,0,0,0"/>
                  </StackPanel>
                </Grid>

                <!-- mappings -->
                <ItemsControl ItemsSource="{Binding Mappings}" Margin="0,10,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="34"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="108"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Drive}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Unc}" Foreground="{DynamicResource TextBody}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Grid.Column="2" Style="{StaticResource Pill}" Background="{Binding StatusBrush}" MaxWidth="108">
                          <TextBlock Style="{StaticResource PillText}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                          <Button Style="{StaticResource MiniButton}" Content="Connect"    Command="{Binding ConnectCommand}"
                                  Visibility="{Binding CanConnect, Converter={StaticResource BoolToVis}}"/>
                          <Button Style="{StaticResource MiniButton}" Content="Reconnect"  Command="{Binding ReconnectCommand}"  Margin="4,0,0,0"/>
                          <Button Style="{StaticResource MiniButton}" Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="4,0,0,0"/>
                          <Button Style="{StaticResource MiniButton}" Content="Unmap"      Command="{Binding UnmapCommand}"      Margin="4,0,0,0"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- log -->
    <TextBlock Grid.Row="2" Text="Activity" FontWeight="SemiBold" Margin="2,8,0,4" Foreground="{DynamicResource TextPrimary}"/>
    <TextBox Grid.Row="3" x:Name="LogBox"
             Text="{Binding Log, Mode=OneWay}" IsReadOnly="True"
             FontFamily="Consolas" FontSize="12"
             Background="{DynamicResource LogBg}" Foreground="{DynamicResource TextBody}"
             BorderBrush="{DynamicResource CardBorder}"
             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
             HorizontalScrollBarVisibility="Auto"
             TextChanged="Log_TextChanged"/>
  </Grid>
</Window>
